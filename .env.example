PORT=3710
# Shared secret the Sarvam agent sends as: Authorization: Bearer <token>
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JARVIS_TOKEN=
# Your mobile number, digits only with country code, e.g. 919876543210. Calls from any other number are refused.
OWNER_NUMBER=
# Optional: the exact hashed caller id Sarvam sends for your number, if it doesn't match automatically.
OWNER_CALLER_ID=
# Allow requests with no caller id (the dashboard's test-agent button). Set false after testing.
ALLOW_NO_CALLER=true
# Shown on the console screen
JARVIS_PHONE=

# --- Local LLM & AI Brain (Zero-API / On-Device Private) ---
# Automatically probes Ollama (http://127.0.0.1:11434/v1), LM Studio (http://127.0.0.1:1234/v1), llama.cpp (http://127.0.0.1:8080/v1)
# Defaults to true: prioritizes on-device private inference
PREFER_LOCAL_LLM=true
# Optional custom local LLM endpoint (e.g. http://127.0.0.1:11434/v1 for Ollama, http://127.0.0.1:1234/v1 for LM Studio)
LOCAL_LLM_URL=
# Optional local model name (e.g. llama3.2, mistral, qwen2.5, deepseek-r1)
LOCAL_LLM_MODEL=

# --- Optional Cloud AI Brain (NVIDIA NIM / OpenAI) ---
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Twilio Outbound Calling (Free Trial - Calls Your Phone Directly) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Agent used for outbound calls (Sarvam alternative - leave empty if using Twilio)
ARRC_APP_ID=
ARRC_APP_VERSION=
ARRC_AGENT_NUMBER=
ARRC_CONNECTION_ID=
# From indus.sarvam.ai > Voice Agents > Settings > API Key. Leave empty for dry-run mode.
SARVAM_WORKSPACE_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
